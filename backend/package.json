{
  "name": "candidate-kit-backend",
  "version": "1.0.0",
  "description": "Sprite editing pipeline API: image edit (OpenAI) -> video (fal) -> spritesheet (FFmpeg)",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml up --build",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "docker:db": "docker compose --env-file .env -f docker/docker-compose.yml up -d postgres",
    "docker:db:down": "docker compose --env-file .env -f docker/docker-compose.yml stop postgres",
    "docker:api": "docker compose --env-file .env -f docker/docker-compose.yml up --build --no-deps backend",
    "docker:api:down": "docker compose --env-file .env -f docker/docker-compose.yml stop backend",
    "docker:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
